# ---- App ----
APP_NAME=LogForge AI
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database ----
POSTGRES_USER=logforge
POSTGRES_PASSWORD=logforge
POSTGRES_DB=logforge
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://logforge:logforge@db:5432/logforge

# ---- LLM (not used until Phase 6 — placeholder only) ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ---- Drift (not used until Phase 5) ----
DRIFT_SIMILARITY_THRESHOLD=0.85

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
