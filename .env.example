# ---- App ----
APP_NAME=LogForge AI
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database ----
POSTGRES_USER=logforge
POSTGRES_PASSWORD=logforge
POSTGRES_DB=logforge
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://logforge:logforge@db:5432/logforge

# ---- LLM (not used until Phase 6 — placeholder only) ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ---- Drift detection (Phase 5) ----
# DRIFT_ENABLED=false restores Phase 0-4 ingestion behavior exactly.
DRIFT_ENABLED=true
# 0.0-1.0; vendor events scoring below this vs. their baseline -> UNDER_REVIEW.
DRIFT_SIMILARITY_THRESHOLD=0.85
# OCSF targets whose removal/type change always forces review (resolved per vendor via adapter YAML).
DRIFT_CRITICAL_FIELDS=event_action,severity,network.src_ip,network.dst_ip,network.src_port,network.dst_port

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
