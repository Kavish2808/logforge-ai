# ---- App ----
APP_NAME=LogForge AI
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database ----
POSTGRES_USER=logforge
POSTGRES_PASSWORD=logforge
POSTGRES_DB=logforge
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://logforge:logforge@db:5432/logforge

# ---- Adaptive onboarding (Phase 3) ----
# The LLM is used ONLY to suggest adapters for unknown sources during
# onboarding — never at runtime. "anthropic" uses Claude when a key is set,
# otherwise the deterministic offline analyzer; "offline" never calls out.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ONBOARDING_LLM_MODEL=claude-opus-5
ONBOARDING_LLM_TIMEOUT_SECONDS=120
# Sandbox thresholds. Passing only makes a proposal eligible for human approval.
ONBOARDING_MIN_MATCH_RATE=0.90
ONBOARDING_REJECT_BELOW_MATCH_RATE=0.50
ONBOARDING_MIN_MAPPING_COVERAGE=0.30
ONBOARDING_RECOMMENDED_SAMPLES=10

# ---- Drift detection (Phase 5) ----
# DRIFT_ENABLED=false restores Phase 0-4 ingestion behavior exactly.
DRIFT_ENABLED=true
# 0.0-1.0; vendor events scoring below this vs. their baseline -> UNDER_REVIEW.
DRIFT_SIMILARITY_THRESHOLD=0.85
# OCSF targets whose removal/type change always forces review (resolved per vendor via adapter YAML).
DRIFT_CRITICAL_FIELDS=event_action,severity,network.src_ip,network.dst_ip,network.src_port,network.dst_port

# ---- Phase 7: trust / integration / governance ----
# Adaptive extension spill: extensions beyond this inline budget are stored
# losslessly in overflow storage (never truncated).
EXTENSION_INLINE_MAX_BYTES=8192
EXTENSION_INLINE_MAX_FIELDS=64
OVERFLOW_EVIDENCE_MIN_OCCURRENCES=3
# Cold raw vault (write-through, content-addressed). Only "filesystem" in Phase 7.
RAW_VAULT_ENABLED=true
RAW_VAULT_BACKEND=filesystem
RAW_VAULT_PATH=./data/raw_vault
# Merkle evidence chain + local append-only (WORM-style) anchor files.
EVIDENCE_ANCHOR_PATH=./data/evidence_anchors
# Anchor provider for sealed Merkle roots; only "local_worm" exists (not compliance-grade WORM).
EVIDENCE_ANCHOR_BACKEND=local_worm
MERKLE_BATCH_MAX_EVENTS=10000
MERKLE_SEAL_GRACE_SECONDS=60
# RBAC: permissive = anonymous governance calls allowed but audited as
# "anonymous" (any presented token is fully enforced); enforce = token required.
# APP_ENV=production refuses to start unless RBAC_MODE=enforce.
RBAC_MODE=permissive
AUTH_TOKEN_TTL_MINUTES=720
# Failed-login lockout (counted from the hash-chained audit log).
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_HASH_ITERATIONS=390000
# Review SLA hours by severity (runtime-overridable by SOC_ADMIN).
SLA_HOURS_CRITICAL=4
SLA_HOURS_HIGH=24
SLA_HOURS_MEDIUM=72
SLA_HOURS_LOW=168
# Export bounds.
EXPORT_MAX_EVENTS=50000
EXPORT_JSON_MAX_EVENTS=5000
EXPORT_BATCH_SIZE=500
# Background scheduler: vault retry, Merkle sealing, SLA sweep, alert checks.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
# Optional alert delivery (all disabled when empty). Treat URLs as secrets.
ALERT_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK_URL=
ALERT_TEAMS_WEBHOOK_URL=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=25
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
